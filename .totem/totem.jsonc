{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {},
  "plugin": ["file:///home/nvii/.config/totem/plugins/session-transcript.mjs"],
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "totem-local": {
      "path": "~/.local/share/totem",
      "description": "Contains totem logs and data",
    },
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "sentry": {
      "type": "local",
      "command": ["npx", "-y", "@sentry/mcp-server"],
      "enabled": true
    },
    "notion": {
      "type": "local",
      "command": ["npx", "-y", "@notionhq/notion-mcp-server"],
      "enabled": true,
      "environment": {
        "NOTION_API_KEY": "${NOTION_API_KEY}"
      }
    },
    "atlassian": {
      "type": "local",
      "command": ["npx", "-y", "mcp-atlassian"],
      "enabled": true,
      "environment": {
        "ATLASSIAN_API_TOKEN": "${ATLASSIAN_API_TOKEN}",
        "ATLASSIAN_EMAIL": "${ATLASSIAN_EMAIL}",
        "ATLASSIAN_SITE": "${ATLASSIAN_SITE}"
      }
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "-y", "shadcn-registry-mcp@latest"],
      "enabled": true
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
