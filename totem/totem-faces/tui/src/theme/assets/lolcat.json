{
  "$schema": "https://totem.ai/theme.json",
  "defs": {
    "red": "#ff5f87",
    "orange": "#ff9f43",
    "amber": "#ffc857",
    "yellow": "#ffe066",
    "lime": "#b8ff5f",
    "green": "#5fff9f",
    "teal": "#5fffd7",
    "cyan": "#5fd7ff",
    "azure": "#5fafff",
    "blue": "#7f87ff",
    "indigo": "#af87ff",
    "violet": "#d787ff",
    "magenta": "#ff5fd7",
    "rose": "#ff87af",

    "inkDark": "#08070c",
    "panelDark": "#12101a",
    "elementDark": "#1c1828",
    "textDark": "#f4f0ff",
    "mutedDark": "#a89ec8",

    "inkLight": "#fffafd",
    "panelLight": "#fdf2f8",
    "elementLight": "#f7e6f0",
    "textLight": "#2a1832",
    "mutedLight": "#6b5878",

    "redDeep": "#c2185b",
    "orangeDeep": "#d2691e",
    "yellowDeep": "#b38600",
    "greenDeep": "#1a8f4c",
    "tealDeep": "#00897b",
    "cyanDeep": "#0277bd",
    "blueDeep": "#3949ab",
    "violetDeep": "#7b1fa2",
    "magentaDeep": "#ad1457",

    "diffAddBgDark": "#0d2a17",
    "diffDelBgDark": "#2e0f1c",
    "diffCtxBgDark": "#141220",
    "diffAddBgLight": "#e3fcec",
    "diffDelBgLight": "#ffe3ee",
    "diffCtxBgLight": "#f7f2fa"
  },
  "theme": {
    "primary": { "dark": "magenta", "light": "magentaDeep" },
    "secondary": { "dark": "cyan", "light": "cyanDeep" },
    "accent": { "dark": "yellow", "light": "yellowDeep" },
    "error": { "dark": "red", "light": "redDeep" },
    "warning": { "dark": "orange", "light": "orangeDeep" },
    "success": { "dark": "green", "light": "greenDeep" },
    "info": { "dark": "azure", "light": "cyanDeep" },

    "text": { "dark": "textDark", "light": "textLight" },
    "textMuted": { "dark": "mutedDark", "light": "mutedLight" },
    "background": { "dark": "inkDark", "light": "inkLight" },
    "backgroundPanel": { "dark": "panelDark", "light": "panelLight" },
    "backgroundElement": { "dark": "elementDark", "light": "elementLight" },

    "border": { "dark": "indigo", "light": "violetDeep" },
    "borderActive": { "dark": "magenta", "light": "magentaDeep" },
    "borderSubtle": { "dark": "blue", "light": "blueDeep" },

    "diffAdded": { "dark": "green", "light": "greenDeep" },
    "diffRemoved": { "dark": "red", "light": "redDeep" },
    "diffContext": { "dark": "mutedDark", "light": "mutedLight" },
    "diffHunkHeader": { "dark": "violet", "light": "violetDeep" },
    "diffHighlightAdded": { "dark": "lime", "light": "greenDeep" },
    "diffHighlightRemoved": { "dark": "rose", "light": "redDeep" },
    "diffAddedBg": { "dark": "diffAddBgDark", "light": "diffAddBgLight" },
    "diffRemovedBg": { "dark": "diffDelBgDark", "light": "diffDelBgLight" },
    "diffContextBg": { "dark": "diffCtxBgDark", "light": "diffCtxBgLight" },
    "diffLineNumber": { "dark": "mutedDark", "light": "mutedLight" },
    "diffAddedLineNumberBg": { "dark": "diffAddBgDark", "light": "diffAddBgLight" },
    "diffRemovedLineNumberBg": { "dark": "diffDelBgDark", "light": "diffDelBgLight" },

    "markdownText": { "dark": "textDark", "light": "textLight" },
    "markdownHeading": { "dark": "magenta", "light": "magentaDeep" },
    "markdownLink": { "dark": "cyan", "light": "cyanDeep" },
    "markdownLinkText": { "dark": "azure", "light": "blueDeep" },
    "markdownCode": { "dark": "lime", "light": "greenDeep" },
    "markdownBlockQuote": { "dark": "violet", "light": "violetDeep" },
    "markdownEmph": { "dark": "amber", "light": "orangeDeep" },
    "markdownStrong": { "dark": "yellow", "light": "yellowDeep" },
    "markdownHorizontalRule": { "dark": "indigo", "light": "violetDeep" },
    "markdownListItem": { "dark": "teal", "light": "tealDeep" },
    "markdownListEnumeration": { "dark": "orange", "light": "orangeDeep" },
    "markdownImage": { "dark": "rose", "light": "redDeep" },
    "markdownImageText": { "dark": "rose", "light": "magentaDeep" },
    "markdownCodeBlock": { "dark": "textDark", "light": "textLight" },

    "syntaxComment": { "dark": "mutedDark", "light": "mutedLight" },
    "syntaxKeyword": { "dark": "magenta", "light": "magentaDeep" },
    "syntaxFunction": { "dark": "cyan", "light": "cyanDeep" },
    "syntaxVariable": { "dark": "orange", "light": "orangeDeep" },
    "syntaxString": { "dark": "green", "light": "greenDeep" },
    "syntaxNumber": { "dark": "amber", "light": "yellowDeep" },
    "syntaxType": { "dark": "violet", "light": "violetDeep" },
    "syntaxOperator": { "dark": "teal", "light": "tealDeep" },
    "syntaxPunctuation": { "dark": "blue", "light": "blueDeep" }
  }
}
