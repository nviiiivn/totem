# Demo environment for totem. Copy to .env (git-ignored) and fill in real values.
# Only needed if you use the "demo-cloud" provider in totem.example.jsonc.
DEMO_API_KEY=replace-me

# Point the cartridge vision extractor at a GPU box instead of localhost.
# 192.0.2.10 is TEST-NET-1 (RFC 5737): a documentation address, replace it.
TOTEM_VISION_BASE_URL=http://192.0.2.10:11434

# Where the session-transcript plugin writes archives on compaction.
TOTEM_SESSION_ARCHIVE_DIR=/home/demo/.local/share/totem/session-archives
